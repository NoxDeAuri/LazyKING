BW_CLIENTID=
BW_CLIENTSECRET=
# Bitwarden master password — leave blank in local dev (you will be prompted).
# In cloud deployment, set this in your platform's secret manager (e.g. Railway Variables).
BW_MASTER_PASSWORD=
TWEEK_API_KEY=twk_YOUR_KEY_HERE
# Your Tweek calendar ID for submission tracking.
# To find it: set TWEEK_API_KEY, start the web server, then open:
#   http://localhost:8765/api/tweek/calendars
# Copy the "id" of your "Queries" calendar and paste it below.
TWEEK_CALENDAR_ID=

# Optional: set a secret to require Authorization: Bearer <secret> on write endpoints.
# Leave blank to disable auth (local-only server, 127.0.0.1 only).
AGENT_SECRET=

# Agent backend: "ollama" (default) or "claude"
AGENT_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ─── Cloud deployment ─────────────────────────────────────────────────────────
# Set DEPLOY=true to:
#   • bind the web server to 0.0.0.0 (required for containers)
#   • mount MCP HTTP/SSE transport at /mcp/sse
# Railway sets PORT automatically; leave WEB_PORT blank when using Railway.
DEPLOY=false
WEB_PORT=8765
